[Unit]
Description=MINAS private app store
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
Environment=MINAS_UID=<你的米家数字UID>
Environment=MINAS_IP=<NAS局域网IP>
Environment=STORE_TOKEN=***
# cftunnel 商品需要（CF Zero Trust 建远程托管隧道后的 token）：
#Environment=CF_TUNNEL_TOKEN=***
ExecStart=/data/apps/store/store -addr :8400 -catalog /data/apps/store/catalog.json
StandardOutput=append:/data/apps/store/store.log
StandardError=append:/data/apps/store/store.log

[Install]
WantedBy=multi-user.target
