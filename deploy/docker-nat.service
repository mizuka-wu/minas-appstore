[Unit]
Description=MINAS docker egress NAT (dockerd runs with iptables:false, no MASQUERADE unless we add it)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 幂等：-C 已存在则跳过；网卡取默认路由出口，不焊死机器名
ExecStart=/bin/sh -c 'IF=$$(ip route | awk "/default/{print $$5; exit}"); sysctl -w net.ipv4.ip_forward=1 >/dev/null; iptables -t nat -C POSTROUTING -s 172.16.0.0/12 -o $$IF -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 172.16.0.0/12 -o $$IF -j MASQUERADE'

[Install]
WantedBy=multi-user.target
